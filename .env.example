# Container image tags
BACKEND_IMAGE=springer-backend:latest
FRONTEND_IMAGE=springer-frontend:latest

# Published host ports
FRONTEND_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=springer
POSTGRES_USER=springer
POSTGRES_PASSWORD=replace-with-a-strong-password
SPRING_PROFILES_ACTIVE=prod,postgresql

# Vite values are embedded during the frontend image build.
VITE_API_URL=/api

# Runtime Nginx proxy values. Use the backend URL reachable from the frontend container.
BACKEND_URL=http://backend:8080
FRONTEND_HOST=your-frontend-domain.example

# Public frontend URL and allowed browser origin
APP_FRONTEND_URL=https://your-frontend-domain.example
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Azure Database for PostgreSQL
SPRINGER_POSTGRES_URL=jdbc:postgresql://postgres:5432/springer
SPRINGER_POSTGRES_USER=springer
SPRINGER_POSTGRES_PASSWORD=replace-with-a-strong-password

# Generate independent long random values for production.
JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_SECRET=replace-with-a-second-long-random-secret

# SMTP (disabled by default; set APP_MAIL_ENABLED=true to use these values)
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password